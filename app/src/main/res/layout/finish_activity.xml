<android.widget.FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false">

    <org.lineageos.setupwizard.widget.RevealHoleView
        android:id="@+id/background"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/linear_layout"
        style="@style/SudContentFrame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/brand_logo"
            android:layout_width="match_parent"
            android:layout_height="0px"
            android:layout_weight="1"
            android:adjustViewBounds="true"
            android:gravity="center"
            android:padding="@dimen/content_margin_left"
            android:scaleType="fitCenter"
            android:src="@drawable/logo" />

        <!-- DriftVaneOS: headline + credit -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:fontFamily="sans-serif-medium"
            android:text="@string/driftvane_all_set"
            android:textColor="@color/dv_logo"
            android:textSize="40sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="28dp"
            android:text="@string/driftvane_made_by"
            android:textColor="@color/dv_muted"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium" />

        <LinearLayout
            android:id="@+id/swipe_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingBottom="@dimen/swipe_hint_padding_bottom">

            <ImageView
                android:id="@+id/swipe_hint_icon"
                android:layout_width="@dimen/swipe_hint_icon_size"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:src="@drawable/ic_swipe_up" />

            <TextView
                android:id="@+id/swipe_hint_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/swipe_hint_text_margin_top"
                android:text="@string/swipe_up_to_go_home"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textSize="@dimen/swipe_hint_text_size" />
        </LinearLayout>

    </LinearLayout>

</android.widget.FrameLayout>
