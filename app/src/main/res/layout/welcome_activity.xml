<!-- DriftVaneOS welcome: glow background, the logo drawing itself in, "Hey.", outlined pill -->
<com.google.android.setupdesign.GlifLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/setup_wizard_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/dv_welcome_glow"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp">

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.3" />

        <ImageView
            android:id="@+id/brand_logo"
            android:layout_width="128dp"
            android:layout_height="64dp"
            android:adjustViewBounds="true"
            android:importantForAccessibility="no"
            android:scaleType="fitStart"
            android:src="@drawable/logo_draw" />

        <TextView
            android:id="@+id/welcome_hey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:text="@string/driftvane_hey"
            android:textColor="@color/dv_logo"
            android:textSize="76sp" />

        <TextView
            android:id="@+id/welcome_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hyphenationFrequency="none"
            android:textColor="@color/dv_logo"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/welcome_credit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/driftvane_made_by"
            android:textColor="@color/dv_muted"
            android:textSize="15sp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="28dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/launch_accessibility"
                style="@style/WelcomeIconButton"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginEnd="14dp"
                android:contentDescription="@string/accessibility_settings"
                app:cornerRadius="30dp"
                app:icon="@drawable/ic_accessibility"
                app:iconSize="26dp"
                app:iconTint="@color/dv_logo"
                app:strokeColor="@color/dv_logo"
                app:strokeWidth="2dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/start"
                style="@style/DvPillButton"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:text="@string/start"
                app:icon="@drawable/ic_arrow_forward"
                app:iconGravity="textEnd"
                app:iconPadding="10dp"
                app:iconSize="22dp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.setupdesign.GlifLayout>
